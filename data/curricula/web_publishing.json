  "difficulty": 4,
  "age_range": { "min": 15, "max": 50 },
  "duration_total_weeks": 16,
  "objectives": [
    "HTML/CSS를 활용한 기초 마크업과 레이아웃 구성",
    "JavaScript를 이용한 동적 기능 구현과 다양한 UI 실습",
    "Figma 시안을 기반으로 HTML/CSS/JS 코드로 구현하는 능력",
    "반응형 웹 제작 및 다양한 클라이언트 요구에 대응"
  ],
  "employment_fields": ["웹에이전시 (브랜드기획팀)", "UI/UX 디자이너", "웹 퍼블리셔", "프론트엔드 개발자"],
  "sections": [
    {
      "section": 1,
      "title": "웹퍼블리셔 1 - HTML & CSS 기초",
      "estimated_courses": ["web_pub_1"],
      "weeks": [
        {
          "week": 1,
          "description": "Visual Studio Code / Figma 설치, HTML 기초 태그, 나열요소와 박스요소, CSS 기본(너비/높이/색상/서체/줄간격/상속), default.css 설정",
          "keywords": ["HTML 기초", "CSS 기본", "나열요소", "박스요소", "서체", "default.css"]
        }
      ]
    },
    {
      "section": 2,
      "title": "웹퍼블리셔 2 - CSS 레이아웃",
      "estimated_courses": ["web_pub_2"],
      "weeks": [
        {
          "week": 2,
          "description": "Box-sizing 이론(너비/여백/테두리/안여백), 셀렉터와 우선순위, 전체 레이아웃/사이트박스",
          "keywords": ["Box-sizing", "셀렉터", "클래스", "아이디", "여백", "테두리"]
        },
        {
          "week": 3,
          "description": "background 속성 활용, 화면 레이아웃 설정, 위치 조절, Background-position 응용",
          "keywords": ["background", "배경이미지", "화면비율", "레이아웃", "background-position"]
        },
        {
          "week": 4,
          "description": "Flex layout 기본이론, Flex-box 활용 방향 요소, 탭내비게이션 실습",
          "keywords": ["Flex", "Flex-box", "flex-direction", "탭내비게이션"]
        },
        {
          "week": 5,
          "description": "CSS position 속성 4가지(static/relative/absolute/fixed), 단계별 레이아웃 실습",
          "keywords": ["position", "relative", "absolute", "fixed", "z-index"]
        },
        {
          "week": 6,
          "description": "flex + position 함께 활용한 실전 레이아웃 배치, top/right/bottom/left 활용",
          "keywords": ["flex + position", "레이아웃 배치", "UI 실습"]
        },
        {
          "week": 7,
          "description": "가상요소(::before/::after), hover/active 상태 동적효과, Transition 애니메이션, keyframe 애니메이션",
          "keywords": ["가상요소", "hover", "active", "transition", "animation", "keyframe"]
        },
        {
          "week": 8,
          "description": "미디어쿼리 기본이론, max-width/min-width 한계값, 다양한 화면크기 레이아웃 최적화, 반응형 이미지 처리",
          "keywords": ["미디어쿼리", "반응형", "max-width", "min-width", "반응형 이미지"]
        }
      ]
    },
    {
      "section": 3,
      "title": "웹퍼블리셔 3 - JavaScript 기초",
      "estimated_courses": ["web_pub_3"],
      "weeks": [
        {
          "week": 9,
          "description": "자바스크립트 기본 타입(문자/숫자/배열/객체), 변수와 데이터 타입, 프로퍼티",
          "keywords": ["변수", "데이터 타입", "배열", "객체", "프로퍼티"]
        },
        {
          "week": 10,
          "description": "DOM 기본(요소 탐색/CSS 속성 추가삭제/HTML 내용 추가삭제), 이벤트 처리",
          "keywords": ["DOM", "요소선택", "CSS 조작", "HTML 조작", "이벤트"]
        },
        {
          "week": 11,
          "description": "querySelector/querySelectorAll 활용, classList로 클래스 추가/제거/전환, 버튼 클릭 알림창",
          "keywords": ["querySelector", "classList", "클릭 이벤트", "알림창"]
        },
        {
          "week": 12,
          "description": "다양한 이벤트(마우스/클릭) 활용, 조건문(if), 반복문(forEach), 탭 UI, 사이드 메뉴, 드롭다운",
          "keywords": ["조건문", "반복문", "forEach", "탭 UI", "드롭다운", "사이드 메뉴"]
        }
      ]
    },
    {
      "section": 4,
      "title": "웹퍼블리셔 4 - JavaScript 심화 & 라이브러리",
      "estimated_courses": ["web_pub_4"],
      "weeks": [
        {
          "week": 13,
          "description": "스크롤이벤트 기본, 스크롤 위치에 따른 텍스트/색상 변경, 메뉴 항목 효과 변경",
          "keywords": ["스크롤 이벤트", "텍스트 변경", "색상 변경", "스크롤 UI"]
        },
        {
          "week": 14,
          "description": "Swiper.js 기본, 자동/수동 슬라이드, 이미지 슬라이드, 페이지네이션",
          "keywords": ["Swiper.js", "슬라이드", "자동슬라이드", "페이지네이션", "라이브러리"]
        },
        {
          "week": 15,
          "description": "드롭다운 메뉴, 슬라이드 메뉴, 아코디언 UI, FAQ 아코디언, 탭 UI, 무한 UI 구현",
          "keywords": ["드롭다운", "아코디언 UI", "탭 UI", "FAQ", "슬라이드 메뉴"]
        },
        {
          "week": 16,
          "description": "전체 레이어드 크리에이티브 사이트 완성 실습, 수직/수평 메뉴, 이미지 전환, 탭/배너 컨트롤",
          "keywords": ["실전 사이트 제작", "수직수평 메뉴", "이미지 전환", "배너", "호버 이벤트"]
        }
      ]
    }
